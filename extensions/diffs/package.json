{
  "name": "@omnipolymath/diffs",
  "version": "2026.11.3",
  "description": "Omnipolymath read-only diff viewer plugin and file renderer for agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/krishnashahane/Omnipolymath"
  },
  "type": "module",
  "dependencies": {
    "@pierre/diffs": "1.6.2",
    "@shikijs/langs": "4.5.0",
    "playwright-core": "1.64.1",
    "typebox": "1.4.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@omnipolymath/plugin-sdk": "workspace:*"
  },
  "omnipolymath": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@omnipolymath/diffs",
      "clawhubSpec": "clawhub:@omnipolymath/diffs",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.30"
    },
    "compat": {
      "pluginApi": ">=2026.11.3"
    },
    "assetScripts": {
      "build": "node --import tsx ../../scripts/build-diffs-viewer-runtime.mts curated"
    },
    "build": {
      "bundledDist": false,
      "omnipolymathVersion": "2026.11.3",
      "staticAssets": [
        {
          "source": "./assets/viewer-runtime.js",
          "output": "assets/viewer-runtime.js"
        }
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
