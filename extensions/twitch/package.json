{
  "name": "@omnipolymath/twitch",
  "version": "2026.11.3",
  "description": "Omnipolymath Twitch channel plugin for chat and moderation workflows.",
  "repository": {
    "type": "git",
    "url": "https://github.com/krishnashahane/Omnipolymath"
  },
  "type": "module",
  "dependencies": {
    "@twurple/api-call": "8.2.0",
    "@twurple/auth": "8.2.0",
    "@twurple/chat": "8.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@omnipolymath/plugin-sdk": "workspace:*"
  },
  "omnipolymath": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "setupFeatures": {
      "configPromotion": true
    },
    "install": {
      "clawhubSpec": "clawhub:@omnipolymath/twitch",
      "npmSpec": "@omnipolymath/twitch",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.11.3"
    },
    "build": {
      "omnipolymathVersion": "2026.11.3"
    },
    "channel": {
      "id": "twitch",
      "configuredState": {
        "env": {
          "anyOf": [
            "OMNIPOLYMATH_TWITCH_ACCESS_TOKEN"
          ]
        }
      },
      "label": "Twitch",
      "selectionLabel": "Twitch (Chat)",
      "docsPath": "/channels/twitch",
      "blurb": "Twitch chat integration",
      "aliases": [
        "twitch-chat"
      ],
      "setup": {
        "fields": []
      }
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
