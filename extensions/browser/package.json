{
  "name": "@omnipolymath/browser-plugin",
  "version": "2026.11.3",
  "private": true,
  "description": "Omnipolymath browser tool plugin",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "acorn": "8.19.0",
    "chrome-devtools-mcp": "1.12.0",
    "express": "5.3.0",
    "playwright-core": "1.64.1",
    "typebox": "1.4.3",
    "yargs-parser": "22.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@omnipolymath/plugin-sdk": "workspace:*",
    "@types/yargs-parser": "21.0.3",
    "undici": "8.12.3"
  },
  "omnipolymath": {
    "build": {
      "workerEntries": [
        "./native-host-entry.ts",
        "./relay-daemon-entry.ts",
        "./setup-entry.ts"
      ]
    },
    "extensions": [
      "./index.ts"
    ],
    "assetScripts": {
      "copy": "node scripts/copy-chrome-extension.mjs"
    }
  },
  "bundleDependencies": [
    "playwright-core"
  ]
}
