{
  "name": "@omnipolymath/facetime",
  "version": "2026.11.3",
  "description": "Experimental FaceTime realtime voice carrier for Omnipolymath agents",
  "license": "MIT",
  "author": "Omnipolymath contributors",
  "homepage": "https://omnipolymath.vercel.app/docs/plugins/facetime",
  "bugs": {
    "url": "https://github.com/krishnashahane/Omnipolymath/issues"
  },
  "keywords": [
    "facetime",
    "omnipolymath",
    "omnipolymath-plugin",
    "realtime-voice"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/krishnashahane/Omnipolymath",
    "directory": "extensions/facetime"
  },
  "files": [
    "assets/icon.png",
    "assets/activity.svg",
    "doctor-contract-api.ts",
    "index.ts",
    "runtime-api.ts",
    "src",
    "docs/phase1-verification.md",
    "helper-endpoint.json",
    "scripts/commit-driver-transaction.sh",
    "scripts/ensure-helper-ipc-key.sh",
    "scripts/inject-helper-terminal.sh",
    "scripts/inject-helper.sh",
    "scripts/install-driver-root.sh",
    "scripts/install-driver.applescript",
    "scripts/install-driver.sh",
    "scripts/remove-user-artifacts.sh",
    "scripts/stage-helper.sh",
    "scripts/verify-native-helper.sh",
    "scripts/verify-xcode-trust.sh",
    "skills/facetime/SKILL.md",
    "skills/facetime/agents/openai.yaml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "omnipolymath.plugin.json"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "type": "module",
  "scripts": {
    "install:driver": "bash scripts/install-driver.sh",
    "uninstall:driver": "bash scripts/install-driver.sh --uninstall",
    "inject:helper": "bash scripts/inject-helper.sh",
    "inject:helper:terminal": "bash scripts/inject-helper-terminal.sh"
  },
  "dependencies": {
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@omnipolymath/plugin-sdk": "workspace:*",
    "omnipolymath": "workspace:*"
  },
  "peerDependencies": {
    "omnipolymath": ">=2026.11.3"
  },
  "peerDependenciesMeta": {
    "omnipolymath": {
      "optional": true
    }
  },
  "omnipolymath": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@omnipolymath/facetime",
      "npmSpec": "@omnipolymath/facetime",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.10.3",
      "allowInvalidConfigRecovery": true
    },
    "compat": {
      "pluginApi": ">=2026.11.3"
    },
    "build": {
      "bundledDist": false,
      "omnipolymathVersion": "2026.11.3"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
