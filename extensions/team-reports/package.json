{
  "name": "@omnipolymath/team-reports",
  "version": "2026.11.3",
  "description": "Omnipolymath team activity reports plugin (GitHub org + Discord activity with model summaries)",
  "repository": {
    "type": "git",
    "url": "https://github.com/krishnashahane/Omnipolymath"
  },
  "type": "module",
  "devDependencies": {
    "@omnipolymath/plugin-sdk": "workspace:*",
    "omnipolymath": "workspace:*"
  },
  "peerDependencies": {
    "omnipolymath": ">=2026.11.3"
  },
  "peerDependenciesMeta": {
    "omnipolymath": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "omnipolymath": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@omnipolymath/team-reports",
      "npmSpec": "@omnipolymath/team-reports",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.2"
    },
    "compat": {
      "pluginApi": ">=2026.11.3"
    },
    "build": {
      "omnipolymathVersion": "2026.11.3",
      "bundledDist": false,
      "workerEntries": [
        "./src/store.worker.ts",
        "./src/run.worker.ts"
      ],
      "staticAssets": [
        {
          "source": "./src/team-reports-schema.postgres.sql",
          "output": "./src/team-reports-schema.postgres.sql"
        },
        {
          "source": "./assets/crab.avif",
          "output": "assets/crab.avif"
        }
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
