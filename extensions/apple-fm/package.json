{
  "name": "@omnipolymath/apple-fm-provider",
  "version": "2026.11.3",
  "private": true,
  "description": "Omnipolymath on-device Apple Foundation Models provider",
  "type": "module",
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@omnipolymath/plugin-sdk": "workspace:*"
  },
  "omnipolymath": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "omnipolymathVersion": "2026.11.3",
      "staticAssets": [
        {
          "source": "./assets/AppleFoundationModels.swift",
          "output": "assets/AppleFoundationModels.swift"
        }
      ]
    }
  }
}
