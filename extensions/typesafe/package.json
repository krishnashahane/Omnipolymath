{
  "name": "@omnipolymath/typesafe",
  "version": "2026.11.3",
  "description": "Omnipolymath TypeSafe typed decision provider",
  "repository": {
    "type": "git",
    "url": "https://github.com/krishnashahane/Omnipolymath"
  },
  "type": "module",
  "dependencies": {
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@omnipolymath/plugin-sdk": "workspace:*"
  },
  "omnipolymath": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@omnipolymath/typesafe",
      "npmSpec": "@omnipolymath/typesafe",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.6"
    },
    "compat": {
      "pluginApi": ">=2026.11.3"
    },
    "build": {
      "bundledDist": false,
      "omnipolymathVersion": "2026.11.3"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
