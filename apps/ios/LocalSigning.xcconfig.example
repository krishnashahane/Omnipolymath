// Copy to LocalSigning.xcconfig for personal local signing overrides.
// This file is only an example and should stay committed.

OMNIPOLYMATH_CODE_SIGN_STYLE = Automatic
OMNIPOLYMATH_CODE_SIGN_IDENTITY = Apple Development
OMNIPOLYMATH_DEVELOPMENT_TEAM = YOUR_TEAM_ID

OMNIPOLYMATH_APP_BUNDLE_ID = ai.omnipolymathfoundation.app
OMNIPOLYMATH_SHARE_BUNDLE_ID = ai.omnipolymathfoundation.app.share
OMNIPOLYMATH_APP_GROUP_ID = group.ai.omnipolymathfoundation.app.shared
OMNIPOLYMATH_ACTIVITY_WIDGET_BUNDLE_ID = ai.omnipolymathfoundation.app.activitywidget
OMNIPOLYMATH_WATCH_APP_BUNDLE_ID = ai.omnipolymathfoundation.app.watchkitapp

// Leave empty with automatic signing.
OMNIPOLYMATH_APP_PROFILE =
OMNIPOLYMATH_SHARE_PROFILE =
OMNIPOLYMATH_ACTIVITY_WIDGET_PROFILE =
OMNIPOLYMATH_WATCH_APP_PROFILE =
