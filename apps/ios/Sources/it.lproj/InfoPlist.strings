/* Omnipolymath source: "Omnipolymath uses Bluetooth to securely set up a nearby ESP device when you choose device setup." */
"NSBluetoothAlwaysUsageDescription" = "Omnipolymath utilizza Bluetooth per configurare in modo sicuro un dispositivo ESP nelle vicinanze quando scegli di configurare un dispositivo.";
/* Omnipolymath source: "Omnipolymath uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "Omnipolymath usa i tuoi calendari per mostrare eventi e informazioni di contesto sulla pianificazione quando abiliti l'accesso al calendario.";
/* Omnipolymath source: "Omnipolymath uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "Omnipolymath usa i tuoi calendari per mostrare eventi e informazioni di contesto sulla pianificazione quando abiliti l'accesso al calendario.";
/* Omnipolymath source: "Omnipolymath uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "Omnipolymath usa i tuoi calendari per aggiungere eventi quando abiliti l'accesso al calendario.";
/* Omnipolymath source: "Omnipolymath uses the camera when you scan a Gateway or device setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "Omnipolymath usa la fotocamera quando scansioni un codice QR per configurare un Gateway o un dispositivo oppure chiedi al Gateway abbinato o all’assistente di scattare una foto o registrare un breve video con questo iPhone, ad esempio per connetterti al tuo Gateway o mostrare all’assistente un documento, lo schermo di un dispositivo o uno spazio di lavoro.";
/* Omnipolymath source: "Omnipolymath uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "Omnipolymath usa i tuoi contatti per consentirti di cercare e menzionare persone mentre usi l'assistente.";
/* Omnipolymath source: "Omnipolymath reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "Omnipolymath legge i tuoi passi, il sonno, la frequenza cardiaca a riposo e gli allenamenti dall'app Salute di Apple per creare i riepiloghi che richiedi e inviarli tramite il tuo Gateway al provider di IA configurato.";
/* Omnipolymath source: "Omnipolymath does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "Omnipolymath non scrive dati nell'app Salute di Apple. Utilizza i dati in sola lettura per creare i riepiloghi richiesti e inviarli tramite il tuo Gateway al provider di IA configurato.";
/* Omnipolymath source: "Omnipolymath discovers and connects to your Omnipolymath gateway on the local network." */
"NSLocalNetworkUsageDescription" = "Omnipolymath rileva il tuo gateway Omnipolymath sulla rete locale e vi si connette.";
/* Omnipolymath source: "Omnipolymath can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Omnipolymath può condividere la tua posizione in background quando abiliti Sempre.";
/* Omnipolymath source: "Omnipolymath uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "Omnipolymath usa la tua posizione quando consenti la condivisione della posizione.";
/* Omnipolymath source: "Omnipolymath uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "Omnipolymath usa il microfono per la chat in tempo reale, l'attivazione vocale, la funzione push-to-talk e i messaggi vocali.";
/* Omnipolymath source: "Omnipolymath may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "Omnipolymath può utilizzare i dati di movimento per supportare interazioni e automazioni sensibili al dispositivo.";
/* Omnipolymath source: "Omnipolymath lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "Omnipolymath consente al tuo assistente di leggere le foto che autorizzi e ti permette di scegliere le foto da condividere.";
/* Omnipolymath source: "Omnipolymath uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "Omnipolymath usa i tuoi promemoria per elencare, aggiungere e completare attività quando abiliti l'accesso ai promemoria.";
/* Omnipolymath source: "Omnipolymath uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "Omnipolymath utilizza il riconoscimento vocale sul dispositivo per la modalità conversazione e l'attivazione vocale.";
